<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="설정"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        style="@style/SectionLabel"
        android:layout_marginTop="16dp"
        android:text="번역 연결" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gemini API 키"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editKey"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="키를 붙여 넣으세요"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/textFaint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/buttonShowKey"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="보기"
                android:textColor="@color/textDim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/buttonCheckKey"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="연결 확인"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="web"
            android:text="무료 키 받기: https://aistudio.google.com/apikey"
            android:textColor="@color/textDim"
            android:textColorLink="@color/teal"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        style="@style/SectionLabel"
        android:layout_marginTop="20dp"
        android:text="번역 환경" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="번역 방식" />

                <TextView
                    android:id="@+id/valueEngine"
                    style="@style/RowValue"
                    android:text="실시간 통역" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/segLive"
                    style="@style/Segment"
                    android:layout_height="38dp"
                    android:text="실시간 통역"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/segListen"
                    style="@style/Segment"
                    android:layout_height="38dp"
                    android:text="듣기 번역"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/segBasic"
                    style="@style/Segment"
                    android:layout_height="38dp"
                    android:text="기본"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textEngineHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/textDim"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="소리 입력" />
            <TextView
                android:id="@+id/valueInput"
                style="@style/RowValue"
                android:text="폰 소리" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowLanguage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="영상 언어" />
            <TextView
                android:id="@+id/valueLanguage"
                style="@style/RowValue"
                android:text="자동 감지" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowOriginal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="원문 함께 보기" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowOffline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="오프라인 음성 인식 우선 (기본 방식)" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SectionLabel"
        android:layout_marginTop="20dp"
        android:text="앱 권한" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowPermMic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="마이크" />
            <TextView
                android:id="@+id/valuePermMic"
                style="@style/RowValue"
                android:text="" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowPermNotif"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="알림" />
            <TextView
                android:id="@+id/valuePermNotif"
                style="@style/RowValue"
                android:text="" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowPermOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="다른 앱 위에 표시" />
            <TextView
                android:id="@+id/valuePermOverlay"
                style="@style/RowValue"
                android:text="" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowPermShare"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="화면 공유" />
            <TextView
                android:id="@+id/valuePermShare"
                style="@style/RowValue"
                android:text="시작 시 요청" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SectionLabel"
        android:layout_marginTop="20dp"
        android:text="진단" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowDiagnose"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="연결 진단" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/rowLastError"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/RowLabel"
                android:text="최근 오류" />
            <TextView
                android:id="@+id/valueLastError"
                style="@style/RowValue"
                android:text="없음" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/textFaint" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/textFaint"
        android:textSize="12sp" />
</LinearLayout>
</ScrollView>
