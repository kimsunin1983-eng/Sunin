<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="영상 소리를 한국어 자막으로"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="영상의 언어"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLang"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="소리 가져오기"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="폰 소리 직접 (이어폰 OK, Android 13 이상)" />

            <RadioButton
                android:id="@+id/radioMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마이크로 듣기 (스피커로 재생할 때)" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/checkOffline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="오프라인 음성 인식 우선 사용" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AI 자연스러운 번역 (Gemini API 키)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비워 두면 Google 번역만 사용"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="무료 키 받기: https://aistudio.google.com/apikey"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="번역 방식 (키가 있을 때)"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/engineLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini 실시간 통역 (가장 빠름 · 실험)" />

            <RadioButton
                android:id="@+id/engineListen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini 듣기 번역 (정확 · 2~4초 늦음)" />

            <RadioButton
                android:id="@+id/engineBasic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기본 (폰 음성 인식 + 번역 + Gemini 다듬기)" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/checkOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자막에 원문도 함께 보기" />

        <Button
            android:id="@+id/buttonDiagnose"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결 진단" />

        <Button
            android:id="@+id/buttonStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="자막 시작"
            android:textSize="17sp" />

        <Button
            android:id="@+id/buttonConversation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="대화 통역 (이어폰 한쪽씩)"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/textInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
